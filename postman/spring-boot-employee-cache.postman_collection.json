{
  "info": {
    "_postman_id": "8f0d2f2a-7f8b-4b3d-9b2a-employee-cache",
    "name": "Spring Boot Employee Cache APIs",
    "description": "Postman collection for the Spring Boot + MySQL + Spring Cache example. Uses employeeId as the cache key. Update baseUrl and request bodies as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": "100"
    }
  ],
  "item": [
    {
      "name": "Get Employee",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Fetch employee by employee_id. First request should query MySQL; subsequent requests may be served from cache."
      },
      "response": []
    },
    {
      "name": "Add Employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"empTableId\": 105,\n  \"employeeId\": 105,\n  \"name\": \"RAHUL\",\n  \"phoneNumber\": 9876543210.0,\n  \"hireDate\": \"2026-10-30\",\n  \"managerId\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "description": "Create an employee. If emp_table_id is AUTO_INCREMENT, remove empTableId from the request body and configure @GeneratedValue(strategy = GenerationType.IDENTITY) on the entity field."
      },
      "response": []
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"ANURAG UPDATED\",\n  \"phoneNumber\": 9876543210.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Update name and phone number. The service uses @CachePut to refresh the employee cache entry."
      },
      "response": []
    },
    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "description": "Delete employee from MySQL and evict the corresponding cache entry."
      },
      "response": []
    }
  ]
}